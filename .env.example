# Application environment
NODE_ENV=development
PORT=8080

# Use a separate development/staging database here. Never paste the production URI.
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster-host>/staysphere_dev

# Create separate development credentials or resources where possible.
SECRET=replace-with-a-long-random-development-secret
MAP_TOKEN=replace-with-a-mapbox-public-token
CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUD_API_KEY=replace-with-cloudinary-api-key
CLOUD_API_SECRET=replace-with-cloudinary-api-secret
