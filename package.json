    "express-session": "^1.19.0",
    "joi": "^18.2.9",
    "mongoose": "^9.10.4",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.2.1"
